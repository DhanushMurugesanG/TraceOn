{
  "name": "traceon-cli",
  "version": "0.0.6",
  "description": "Runtime verification for AI coding agents. MCP server that lets Claude Code verify code changes work end-to-end via Playwright + OpenTelemetry + SigNoz.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "claude-code",
    "playwright",
    "opentelemetry",
    "signoz",
    "verification",
    "ai-agents"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "traceon": "bin/cli.js"
  },
  "files": [
    "bin/",
    "dist/",
    "lib/",
    "skills/",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DhanushMurugesanG/TraceOn.git"
  },
  "homepage": "https://github.com/DhanushMurugesanG/TraceOn",
  "bugs": "https://github.com/DhanushMurugesanG/TraceOn/issues",
  "scripts": {
    "build": "pnpm -r build",
    "build:bundle": "node scripts/bundle.mjs",
    "build:all": "pnpm -r build && node scripts/bundle.mjs",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "prepublishOnly": "pnpm build:all"
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  }
}
